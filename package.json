{
  "name": "resend-exporter",
  "version": "0.0.0",
  "private": true,
  "description": "Prometheus exporter and webhook receiver for Resend email events",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robbeverhelst/resend-exporter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --minify src/index.ts --outfile dist/resend-exporter",
    "check:lint": "bunx bun@1.4.3-canary.20261014.1 lint",
    "fix:lint": "bunx bun@1.4.3-canary.20261014.1 lint --fix",
    "fix:fmt": "bunx bun@1.4.3-canary.20261014.1 fmt",
    "check:fmt": "bunx bun@1.4.3-canary.20261014.1 fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:bun-native": "bun run scripts/check-bun-native.ts"
  },
  "dependencies": {
    "prom-client": "^15.1.3",
    "svix": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.4.4",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
